# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini API key, used to generate the short post summary
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# X/Twitter data provider (default implementation: twitterapi.io)
X_API_KEY=
X_API_BASE_URL=https://api.twitterapi.io

# Optional tuning (seconds)
CACHE_TTL_SECONDS=600
RATE_LIMIT_SECONDS=5

# --- Webhook mode (used on Render) ---
# Set to "false" to run with polling instead, e.g. for local development.
USE_WEBHOOK=true
# Random string used to validate that webhook requests really come from
# Telegram. Generate any long random value, e.g.: openssl rand -hex 32
WEBHOOK_SECRET=
# On Render this is auto-injected as RENDER_EXTERNAL_URL - leave blank here.
# If hosting elsewhere, set WEBHOOK_URL to your service's public https URL.
WEBHOOK_URL=
# Render also auto-injects PORT - only needed locally if testing webhook mode.
PORT=10000
